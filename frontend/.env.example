# Formaton — Variables de entorno del frontend
# Copiar a .env.local y rellenar con los valores del stack CDK (outputs)

# URL base de la API Gateway (sin trailing slash)
# Obtener de: aws cloudformation describe-stacks --stack-name Formaton-Api-dev --query "Stacks[0].Outputs"
VITE_API_URL=https://xxxxxxxxxx.execute-api.eu-west-1.amazonaws.com/dev

# Cognito — AuthStack outputs
VITE_USER_POOL_ID=eu-west-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Región AWS
VITE_AWS_REGION=eu-west-1

# Nombre del entorno (dev | prod)
VITE_ENV=dev
